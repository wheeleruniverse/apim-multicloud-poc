# terraform.tfvars.example
#
# This file shows optional overrides for LOCAL Terraform runs only.
#
# GitHub Actions deployments do NOT use this file - they use:
#   - Terraform variable defaults (variables.tf)
#   - GitHub variables (APIM_PUBLISHER_EMAIL)
#   - GitHub secrets (TF_VAR_apim_gateway_token)
#
# To use locally: cp terraform.tfvars.example terraform.tfvars
# (terraform.tfvars is gitignored)

# =============================================================================
# REQUIRED FOR LOCAL RUNS
# =============================================================================

# Publisher email (required - no default in Terraform)
apim_publisher_email = "your-email@example.com"

# Gateway token (required for AWS deployment)
# Generate after Azure APIM is created:
# az apim gateway token create \
#   --gateway-id aws-self-hosted-gateway \
#   --resource-group apim-multicloud-poc-dev-apim-rg \
#   --service-name apim-multicloud-poc-dev-apim \
#   --expiry "2025-12-31T23:59:59Z" \
#   --query value -o tsv
apim_gateway_token = "your-generated-token-here"

# =============================================================================
# OPTIONAL OVERRIDES (uncomment to override defaults)
# =============================================================================

# apim_publisher_name = "wheeleruniverse"  # Default in variables.tf
# environment         = "dev"              # Default in variables.tf
# azure_location      = "eastus"           # Default in variables.tf
# aws_region          = "us-east-1"        # Default in variables.tf
# aks_node_count      = 1                  # Default in variables.tf
# eks_desired_nodes   = 1                  # Default in variables.tf
# gateway_replicas    = 1                  # Default in variables.tf
